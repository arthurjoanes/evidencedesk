# Public demo defaults. Real secrets belong in a protected file outside this repo/OneDrive.
ED_COMPOSE_PROJECT=pf-evidencedesk
ED_DATABASE_PORT=5546
ED_API_PORT=8106
ED_FRONTEND_PORT=3106
ED_DB_ADMIN_PASSWORD=ed_admin_local_demo
ED_DB_OWNER_PASSWORD=ed_owner_local_demo
ED_DB_APP_PASSWORD=ed_app_local_demo
ED_METRICS_TOKEN=ed_metrics_local_demo
ED_COOKIE_SECURE=false
ED_ALLOWED_ORIGINS=http://localhost:3106,http://127.0.0.1:3106
ED_AI_PROVIDER=azure_openai
AZURE_OPENAI_BASE_URL=https://agentes-sol-foundry.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional offline ML profile; set an internal token >=24 chars before starting models.
ED_RETRIEVAL_MODE=lexical
ED_MODEL_SERVICE_TOKEN=

ED_AI_PERIOD_TOKEN_BUDGET=100000
ED_AI_MAX_INPUT_TOKENS=10000
ED_AI_MAX_OUTPUT_TOKENS=2400
ED_POOL_SIZE=4
ED_CURSOR_SECRET=local-only-change-before-non-loopback
