# Exemplo público. O arquivo não é lido automaticamente pelo backend.
# Compose: python scripts/ops.py --env-file <arquivo-protegido> start
# Referência completa de portas/defaults: infra/compose/runtime.env.example
# Nunca grave a chave real neste arquivo/repositório/OneDrive.
ED_COMPOSE_PROJECT=pf-evidencedesk
ED_AI_PROVIDER=azure_openai
ED_RETRIEVAL_MODE=lexical
ED_MODEL_SERVICE_TOKEN=
ED_AI_PERIOD_TOKEN_BUDGET=100000
ED_AI_MAX_INPUT_TOKENS=10000
ED_AI_MAX_OUTPUT_TOKENS=2400
AZURE_OPENAI_BASE_URL=https://agentes-sol-foundry.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
